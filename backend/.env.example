# Server Configuration
PORT=5000

# MongoDB Connection (Local or Atlas URI)
# Local example: mongodb://localhost:27017/mockmate
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mockmate?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# ML Service URL
ML_SERVICE_URL=http://localhost:8000
